{
  "manifest_version": 3,
  "name": "Myntra Picklist Panel",
  "version": "0.1.0",
  "description": "Shows the picklist beside the Myntra pack page. Click a row to fill the SKU.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://mdirect.myntrainfo.com/*",
    "*://partnersapi.myntrainfo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Myntra Picklist Panel"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mdirect.myntrainfo.com/PackOrder/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://mdirect.myntrainfo.com/PackOrder/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
